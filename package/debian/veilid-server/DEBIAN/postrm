#!/bin/sh

set -e

# Remove the SELinux policy module on remove/purge (no-op if SELinux is off).
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v semodule >/dev/null 2>&1 && command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then
        semodule -r veilid_server 2>/dev/null || true
    fi
fi

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

if [ "$1" = "remove" ]; then
    if [ -x "/usr/bin/deb-systemd-helper" ]; then
        deb-systemd-helper mask 'veilid-server.service' >/dev/null || true
    fi
elif [ "$1" = "purge" ]; then
    if [ -x "/usr/bin/deb-systemd-helper" ]; then
        deb-systemd-helper purge 'veilid-server.service' >/dev/null || true
        deb-systemd-helper unmask 'veilid-server.service' >/dev/null || true
    fi
    rm -rf /var/db/veilid-server
fi

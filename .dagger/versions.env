# veilid build & dev-tool versions — single source of truth.
#
# POLYGLOT: every line is `KEY="value"` (no spaces around =), valid as BOTH shell
# (source this file) AND Python (importlib loads it). Lives in .dagger/ so the
# Dagger module runtime can import it (only .dagger is mounted there); the host-side
# scripts and Earthfile read it from the repo.
#
# Consumed by:
#   .dagger/src/veilid/main.py   importlib (Dagger build)
#   Earthfile                    (version pins; keep in sync)
#   scripts/tool_tags.sh         source     (per-tool CI cache tags; Earthfile + .gitlab-ci.yml read it)
#   dev-setup/setup_*.sh         source     (dev-setup, host)
#   dev-setup/setup_windows.ps1  parse      (dev-setup, Windows)
# Edit here, then re-run dev-setup/setup_<os>.sh and the build.

# --- Rust ---
RUST_VERSION="1.92.0"                              # toolchain the build pins
RUSTUP_VERSION="1.29.1"                            # rustup-init honours it; auto-install rules changed across releases
RUST_MSRV="1.89.0"                                 # minimum a dev's rustc may be
RUST_UNIT_TESTS_NIGHTLY_VERSION="nightly-2026-01-01"
RUST_PACKAGE_TESTS_NIGHTLY_VERSION="nightly"
WASM_BINDGEN_VERSION="0.2.121"                     # MUST match Cargo.lock wasm-bindgen
CARGO_EDIT_VERSION="0.13.0"
AST_GREP_VERSION="0.45.3"                          # census gate engine (scripts/update_census.sh)
EARTHLY_VERSION="0.8.15"                           # CI downloads this binary; its buildkitd image is mirrored per-project

# --- Cargo tools the build installs (pinned so each gets its own cache tag) ---
CARGO_ZIGBUILD_VERSION="0.23.4"                    # built from source; no musl release to binstall
CARGO_BINSTALL_VERSION="1.23.0"                    # the installer script honours BINSTALL_VERSION
CARGO_MSRV_VERSION="0.19.3"
CARGO_NEXTEST_VERSION="0.9.144"
CARGO_DOCS_RS_VERSION="1.0.4"
CARGO_PUBLIC_API_VERSION="0.52.0"
CARGO_SYNC_README_VERSION="1.1.0"

# --- Rust build targets (Earthly + Dagger + dev-setup all read these) ---
# Space-separated; consumers split on whitespace. Shared set: installed by CI
# (Earthly/Dagger, Linux-only) and every dev-setup host. aarch64-apple-darwin is here
# for CI clippy lint only (no Apple binary is built in CI); the Android targets are
# installed but not yet built (kept for the eventual veilidchat-in-Dagger build).
# Extra Apple targets (Intel macOS + iOS) are split out — only macOS dev-setup adds them.
RUST_STABLE_TARGETS="x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu x86_64-unknown-linux-musl aarch64-unknown-linux-musl x86_64-pc-windows-gnu aarch64-apple-darwin aarch64-linux-android armv7-linux-androideabi i686-linux-android x86_64-linux-android wasm32-unknown-unknown"
RUST_STABLE_TARGETS_APPLE="x86_64-apple-darwin aarch64-apple-ios aarch64-apple-ios-sim x86_64-apple-ios"
RUST_NIGHTLY_TARGETS="x86_64-unknown-linux-gnu"

# glibc floor for the shipped linux binaries. cargo-zigbuild takes it as a `.<version>` suffix on
# the target triple and links against zig's stubs for that release, so THIS — not the build
# container's glibc — is what sets the floor. 2.17 is the documented Rust minimum for both tier-1
# linux-gnu targets. Keep the package metadata in package/debian and package/rpm in step with it.
GLIBC_FLOOR="2.17"

# --- Flutter / Dart (veilid-flutter) ---
FLUTTER_VERSION="3.47.1"                            # pinned SDK the optional --flutter step installs
FLUTTER_MIN_VERSION="3.47.1"                        # veilid-flutter's flutter requirement (keep in sync with veilid-flutter/pubspec.yaml)
DART_VERSION="3.13.1"                               # Dart SDK that FLUTTER_VERSION ships; bump together. Drives the dart format gate.

# --- Native build tools ---
ZIG_VERSION="0.13.0"
CMAKE_VERSION_MINOR="4.0"
CMAKE_VERSION_PATCH="4.0.2"                        # downloaded by the Windows dev-setup
CMAKE_MIN_VERSION="3.24"                           # minimum a dev's host cmake may be
BINARYEN_VERSION="125"
CAPNP_MIN_VERSION="1.0.1"
JAVA_MIN_VERSION="17.0"                            # minimum a dev's host java may be
JAVA_VERSION="17"                                  # JDK the dev-setup installs for Android work (winget, brew/apt openjdk)
XWIN_VERSION="0.10.0"                              # fetches the MSVC CRT and Windows SDK the prebuilt veilid-flutter Windows library links
XWIN_CRT_VERSION="14.44.17.14"                     # that CRT: MSVC 19.44, as the Windows CI image
XWIN_SDK_VERSION="10.0.26100"                      # that Windows SDK

# --- Android SDK ---
ANDROID_CMDLINE_TOOLS_VERSION="13114758"           # commandlinetools-linux zip build number
ANDROID_NDK_VERSION="28.2.13676358"
ANDROID_PLATFORM_VERSION="36"
ANDROID_BUILD_TOOLS_VERSION="35.0.0"
ANDROID_CMAKE_VERSION="4.0.2"

# --- Windows host dev tools (Linux/macOS get these from the system package manager) ---
VS_VERSION="17"                                    # Visual Studio major (2022) — vs_buildtools URL + vswhere range
WINDOWS_SDK_VERSION="19041"                        # Windows 10 SDK component for the VS Build Tools install
PYTHON_VERSION="3.12"                              # winget Python pin (Windows; *nix use the system python3)
GIT_WINDOWS_TAG="v2.55.0.windows.2"                # git-for-windows release tag (PortableGit, prefix installs)
GIT_WINDOWS_FILE="PortableGit-2.55.0.2-64-bit.7z.exe"  # its PortableGit asset (name scheme varies per tag)

# --- Container build images (Dagger / Earthly Linux builds) ---
# The compile container. GLIBC_FLOOR, not this, sets how portable the shipped binaries are, so
# this tracks whatever is convenient to build on. Earthfile duplicates the literal (its FROM runs
# before this file is available); check_all.sh fails if the two drift.
LINUX_BUILD_IMAGE="ubuntu:24.04"
# The deb's SELinux module is compiled here, deliberately apart from the compile container:
# checkmodule emits the newest policy version its refpolicy knows (18.04 -> 19, 22.04 -> 20,
# 24.04 -> 21) and a module cannot be loaded by a system whose libsepol is older. Raise this only
# to drop support for older SELinux-enabled Debian/Ubuntu. The RPM path builds its own on
# RPM_BUILD_IMAGE and is unaffected.
SELINUX_POLICY_IMAGE="ubuntu:18.04"
# Bump when you change deps-base's apt package list or its setup steps. Those live in the
# Earthfile, which the tag cannot see, so this is the manual half of the deps-base cache key.
DEPS_BASE_REVISION="4"
# Same idea for deps-flutter's apt list (it installs its own prerequisites on FLUTTER_BUILD_IMAGE
# rather than sharing deps-base). Bump when that list or its setup steps change.
DEPS_FLUTTER_REVISION="1"
FLUTTER_BUILD_IMAGE="ubuntu:24.04"                 # flutter test container — ships nothing, so the glibc floor buys it nothing
NODE_MAJOR="22"                                    # Node for the TypeScript lint image and the host check; the format job image in .gitlab-ci.yml follows it
RPM_BUILD_IMAGE="rockylinux:9"                     # .rpm builder (rpm-build / rpmdevtools)
PACKAGING_IMAGE="alpine:latest"                    # minimal tar/collect container

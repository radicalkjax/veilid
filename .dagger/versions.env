# veilid build & dev-tool versions — single source of truth.
#
# POLYGLOT: every line is `KEY="value"` (no spaces around =), valid as BOTH shell
# (source this file) AND Python (importlib loads it). Lives in .dagger/ so the
# Dagger module runtime can import it (only .dagger is mounted there); the host-side
# scripts and Earthfile read it from the repo.
#
# Consumed by:
#   .dagger/src/veilid/main.py   importlib (Dagger build)
#   Earthfile                    (version pins; keep in sync)
#   dev-setup/setup_*.sh         source     (dev-setup, host)
#   dev-setup/setup_windows.ps1  parse      (dev-setup, Windows)
# Edit here, then re-run dev-setup/setup_<os>.sh and the build.

# --- Rust ---
RUST_VERSION="1.92.0"                              # toolchain the build pins
RUST_MSRV="1.89.0"                                 # minimum a dev's rustc may be
RUST_UNIT_TESTS_NIGHTLY_VERSION="nightly-2026-01-01"
RUST_PACKAGE_TESTS_NIGHTLY_VERSION="nightly"
WASM_BINDGEN_VERSION="0.2.121"                     # MUST match Cargo.lock wasm-bindgen
CARGO_EDIT_VERSION="0.13.0"

# --- Rust build targets (Earthly + Dagger + dev-setup all read these) ---
# Space-separated; consumers split on whitespace. Shared set: installed by CI
# (Earthly/Dagger, Linux-only) and every dev-setup host. aarch64-apple-darwin is here
# for CI clippy lint only (no Apple binary is built in CI); the Android targets are
# installed but not yet built (kept for the eventual veilidchat-in-Dagger build).
# Extra Apple targets (Intel macOS + iOS) are split out — only macOS dev-setup adds them.
RUST_STABLE_TARGETS="x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu x86_64-unknown-linux-musl aarch64-unknown-linux-musl x86_64-pc-windows-gnu aarch64-apple-darwin aarch64-linux-android armv7-linux-androideabi i686-linux-android x86_64-linux-android wasm32-unknown-unknown"
RUST_STABLE_TARGETS_APPLE="x86_64-apple-darwin aarch64-apple-ios aarch64-apple-ios-sim x86_64-apple-ios"
RUST_NIGHTLY_TARGETS="x86_64-unknown-linux-gnu"

# --- Flutter / Dart (veilid-flutter) ---
FLUTTER_VERSION="3.44.0"                            # pinned SDK the optional --flutter step installs
FLUTTER_MIN_VERSION="3.41.0"                        # veilid-flutter's flutter requirement (keep in sync with veilid-flutter/pubspec.yaml)

# --- Native build tools ---
ZIG_VERSION="0.13.0"
CMAKE_VERSION_MINOR="4.0"
CMAKE_VERSION_PATCH="4.0.2"                        # downloaded by the build
CMAKE_MIN_VERSION="3.24"                           # minimum a dev's host cmake may be
BINARYEN_VERSION="125"
CAPNP_MIN_VERSION="1.0.1"
JAVA_MIN_VERSION="17"                             # minimum a dev's host java may be
JAVA_VERSION="17"                                  # JDK the dev-setup installs (Windows cross-JDK; brew/apt openjdk)

# --- Android SDK ---
ANDROID_CMDLINE_TOOLS_VERSION="13114758"           # commandlinetools-linux zip build number
ANDROID_NDK_VERSION="28.2.13676358"
ANDROID_PLATFORM_VERSION="36"
ANDROID_BUILD_TOOLS_VERSION="35.0.0"
ANDROID_CMAKE_VERSION="4.0.2"

# --- Windows host dev tools (Linux/macOS get these from the system package manager) ---
VS_VERSION="17"                                    # Visual Studio major (2022) — vs_buildtools URL + vswhere range
WINDOWS_SDK_VERSION="19041"                        # Windows 10 SDK component for the VS Build Tools install
PYTHON_VERSION="3.12"                              # winget Python pin (Windows; *nix use the system python3)
GIT_WINDOWS_TAG="v2.55.0.windows.2"                # git-for-windows release tag (PortableGit, prefix installs)
GIT_WINDOWS_FILE="PortableGit-2.55.0.2-64-bit.7z.exe"  # its PortableGit asset (name scheme varies per tag)

# --- Container build images (Dagger / Earthly Linux builds) ---
LINUX_BUILD_IMAGE="ubuntu:18.04"                   # compile container — old glibc => portable binaries
RPM_BUILD_IMAGE="rockylinux:9"                     # .rpm builder (rpm-build / rpmdevtools)
PACKAGING_IMAGE="alpine:latest"                    # minimal tar/collect container
